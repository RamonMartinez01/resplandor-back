# ============================================
# RESPLANDOR-01 - CONFIGURACIÓN DE ENTORNO
# ============================================
# ¡NUNCA SUBIR EL ARCHIVO .ENV A GITHUB!
# ============================================

# 1. SERVIDOR Y ENTORNO
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# 2. BASE DE DATOS POSTGRESQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/<ejemplo_db>
# Alternativa con variables separadas (Sequelize CLI puede usarlas):
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_DATABASE=tours_geneve
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# 3. AUTENTICACIÓN JWT
JWT_SECRET=tu_super_secreto_jwt_muy_largo_y_complejo_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# 4. CLOUDINARY (Medios / Imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# 5. DESARROLLO (Endpoints /api/dev)
DEV_SECRET=dev_secret_solo_para_entorno_desarrollo